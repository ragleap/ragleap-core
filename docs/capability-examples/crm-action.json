{
  "schema": "ragleap.capability/1",
  "id": "example.crm",
  "version": "1.0.0",
  "kind": "action",
  "operations": [
    {"name": "update_crm_record", "effect": "external_send", "approval": "per_mode", "taint": "outbound", "args": "crm-update-args"}
